# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored; .env.example is committed.
# Consumed by BOTH docker-compose.yml and the FastAPI app (app/core/config.py).
# ---------------------------------------------------------------------------

# --- Application ---
PROJECT_NAME="Project Dashboard API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Postgres ---
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard_dev_pw
POSTGRES_DB=dashboard
# Host as seen FROM the FastAPI process. Running uvicorn on the host -> localhost.
# If you later containerise the API, change this to: db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (comma-separated, no trailing slash) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Application JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
SESSION_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_NAME=project_dashboard_session
# Use true behind HTTPS in staging/production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
# Set SESSION_COOKIE_DOMAIN only when cookies must span trusted subdomains.

# OAuth state/PKCE cookies should be secure in HTTPS environments.
OAUTH_COOKIE_SECURE=false
OAUTH_STATE_TTL_SECONDS=600
FRONTEND_AUTH_CALLBACK_URL=http://127.0.0.1:5173/auth/callback

# Only these accounts may sign in (comma-separated, case-insensitive).
ALLOWED_EMAILS=you@example.com

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/api/v1/auth/google/callback

# --- Microsoft identity platform ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8010/api/v1/auth/microsoft/callback
